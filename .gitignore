# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# keys and certificates (CL-37)
*.pem
*.p8
*.p12
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit (CL-37). .env.example holds names only, no values.
.env
.env*.local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI
supabase/.temp/

# real data must never be committed (public repo, CL-37).
# Keep it outside the repo folder, e.g. D:\jkalc\costline-data\
/private/
Data Source*.xlsx
*.xlsx
*.xls
