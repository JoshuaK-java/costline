# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=              # https://<ref>.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_...  (browser-safe)
SUPABASE_SECRET_KEY=                   # sb_secret_...  SERVER ONLY, never NEXT_PUBLIC_
SUPABASE_PROJECT_REF=                  # used by CLI/CI

# --- App ---
NEXT_PUBLIC_APP_URL=                   # http://localhost:3000 locally

# --- Sentry (CL-75) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                     # build-time only (source maps)

# --- Email (Sprint 11) ---
EMAIL_API_KEY=